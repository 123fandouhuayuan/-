# Django配置
# ==============================================================================

# 安全密钥：用于加密会话、CSRF保护等
# 生产环境请使用强随机密钥，可通过以下方式生成：
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here-change-in-production

# 调试模式：生产环境必须设置为False
DEBUG=True

# 允许的主机：生产环境需要设置实际的域名或IP
# 多个主机用逗号分隔，例如：example.com,www.example.com,192.168.1.100
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置（达梦数据库）
# ==============================================================================
DB_NAME=DATABASE_NAME
DB_USER=SYSDBA
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5236

# 邮箱配置
# ==============================================================================
# 用于发送密码重置邮件、验证码等

# SMTP服务器地址
EMAIL_HOST=smtp.qq.com

# SMTP端口（QQ邮箱: 587, 163邮箱: 465, Gmail: 587）
EMAIL_PORT=587

# 是否使用TLS加密（QQ邮箱/Gmail: True, 163邮箱: False）
EMAIL_USE_TLS=True

# 是否使用SSL加密（163邮箱: True）
EMAIL_USE_SSL=False

# SMTP登录用户名（邮箱地址）
EMAIL_HOST_USER=your-email@example.com

# SMTP登录密码（授权码，非邮箱密码）
EMAIL_HOST_PASSWORD=your-auth-code

# 发件人显示名称
DEFAULT_FROM_EMAIL=系统通知 <your-email@example.com>

# 可选配置
# ==============================================================================

# 静态文件收集目录（可选，默认为staticfiles）
# STATIC_ROOT=/path/to/staticfiles

# 媒体文件存储目录（可选，默认为media）
# MEDIA_ROOT=/path/to/media

# 日志级别（可选，默认为INFO）
# LOG_LEVEL=INFO
